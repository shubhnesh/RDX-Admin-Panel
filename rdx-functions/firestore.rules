rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
          (request.auth.token.role == 'admin' ||
              request.auth.token.admin == true);
    }

    function isStaff() {
      return isSignedIn() && request.auth.token.role == 'staff';
    }

    function isRestaurantUser() {
      return isAdmin() || isStaff();
    }

    match /orders/{orderId} {
      allow read: if isRestaurantUser() ||
          (isSignedIn() && resource.data.customer_id == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /menu_items/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /menu_categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /menu_preparations/{preparationId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /menu_regionalities/{regionalityId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /menu_tags/{tagId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /preparations/{preparationId} {
      allow read: if isRestaurantUser();
      allow create, update, delete: if isAdmin();
    }
    match /regionalities/{regionalityId} {
      allow read: if isRestaurantUser();
      allow create, update, delete: if isAdmin();
    }
    match /tags/{tagId} {
      allow read: if isRestaurantUser();
      allow create, update, delete: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /offers/{offerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /inventory/{itemId} {
      allow read, write: if false;
    }
    match /inventory_categories/{categoryId} {
      allow read, write: if isAdmin();
    }
    match /inventory_units/{unitId} {
      allow read, write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isRestaurantUser();
      allow write: if false;
    }
    match /settings/fees {
      // Signed-in customers need fee settings for the checkout estimate.
      allow read: if isSignedIn();
    }
    match /table_config/{configId} {
      allow read: if isRestaurantUser();
      allow write: if isAdmin();
    }
    match /table/{tableId} {
      allow read: if isRestaurantUser();
      allow write: if isAdmin();
    }
    match /tables/{tableId} {
      allow read: if isRestaurantUser();
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() &&
          request.auth.uid == userId &&
          request.resource.data.keys().hasOnly([
            'full_name',
            'email',
            'phone',
            'theme_mode',
            'created_at',
            'updated_at'
          ]);
      allow update: if isSignedIn() &&
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'full_name',
            'email',
            'phone',
            'theme_mode',
            'updated_at'
          ]);
      allow delete: if false;
      match /cart/{itemId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
      match /addresses/{addressId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow write: if false;
      }
      match /{document=**} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow write: if isSignedIn() &&
            request.auth.uid == userId &&
            document.size() > 0 &&
            document.split('/')[0] != 'addresses';
      }
    }

    match /staff_profiles/{userId} {
      allow read, write: if false;
    }

    match /rewards/{rewardId} {
      allow read, write: if isAdmin();
    }
    match /reward_catalog/{rewardId} {
      allow read, write: if isAdmin();
    }
    match /reward_claims/{claimId} {
      allow read: if isAdmin() ||
          (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
    match /reward_wallets/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }
    match /reward_ledger/{entryId} {
      allow read: if isSignedIn() &&
          resource.data.user_id == request.auth.uid;
      allow write: if false;
    }
    match /notifications/{notificationId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
