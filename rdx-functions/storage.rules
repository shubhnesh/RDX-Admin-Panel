rules_version = '2';

// Secure Storage rules for RDX Restaurant
// - Promotional videos (vid-*.mp4) are publicly readable so the app can stream them
// - NO client (even authenticated) can create, update, delete, or overwrite any file
// - All other paths remain fully locked
// Deploy these rules in Firebase Console → Storage → Rules

service firebase.storage {
  match /b/{bucket}/o {

    // Explicit allow-list for the four promo videos only.
    // Pattern matches vid-1.mp4, vid-2.mp4, vid-3.mp4, vid-4.mp4
    match /vid-{videoId}.mp4 {
      // Anyone can read / stream the video
      allow read: if true;

      // Clients can never write, overwrite, or delete
      allow write: if false;
    }

    // Catch-all: deny every other path and every write
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
